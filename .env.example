# Database used by server.js and test-connection.js. Copy to .env and fill in.
# .env itself stays gitignored — never commit the real values.
HOST = your-host.example
PORT = 3306
USER = your-user
PASSWORD = your-password
DATABASE = your-database

# Google Identity (OpenID Connect) — OAuth 2.0 Client (Web) from Google Cloud Console.
# The client ID is PUBLIC (index.html also reads it), but keep it in .env so the
# same value configures the server-side token check. Leave empty to disable login:
# the games then stay playable and scores are kept only in localStorage.
GOOGLE_CLIENT_ID = your-google-client-id.apps.googleusercontent.com
